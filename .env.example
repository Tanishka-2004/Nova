# Nova — Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ───────────────────────────────────────────
# SQLite local database (dev)
DATABASE_URL="file:./packages/database/prisma/dev.db"

# ─── OpenAI ─────────────────────────────────────────────
# OpenAI API Key — required if not using Gemini
OPENAI_API_KEY="sk-..."

# Model configuration — change to gpt-4o for final demo
OPENAI_CHAT_MODEL="gpt-4o-mini"

# ─── Gemini ──────────────────────────────────────────────
# Gemini API Key — preferred model
GEMINI_API_KEY="AQ..."
GEMINI_CHAT_MODEL="gemini-2.5-flash"

# ─── Channel Service ───────────────────────────────────
# Local (dev)
CHANNEL_SERVICE_URL="http://localhost:8001"

# Fly.io (prod) — uncomment when deploying
# CHANNEL_SERVICE_URL="https://nova-channel-service.fly.dev"

# ─── App ────────────────────────────────────────────────
# The public URL of the Next.js app (for webhook callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
